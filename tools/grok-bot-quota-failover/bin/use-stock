#!/usr/bin/env bash
set -euo pipefail
DIR="$(cd "$(dirname "$0")/.." && pwd)"
# shellcheck source=../lib.sh
source "$DIR/lib.sh"

echo cursor >"$DESIRED_FILE"
bin="$(adapters_bin)" || {
  log "adapters CLI not on this machine; desired-mode=cursor (run install.sh inside Grok Bot sandbox)"
  notify "Want official Grok, but adapters is not on this machine. Run install.sh / use-stock in the Grok Bot sandbox."
  exit 0
}
log "switching to stock Cursor / official Grok"
"$bin" use cursor
write_state mode=cursor last_action=use-stock
notify "Switched back to official Grok (adapters use cursor). Later turns use included quota."
"$bin" status || true
