#!/usr/bin/env bash
# Decide stock vs Codex from Cursor period usage.
set -euo pipefail
DIR="$(cd "$(dirname "$0")/.." && pwd)"
# shellcheck source=../lib.sh
source "$DIR/lib.sh"

mkdir -p "$FAILOVER_DIR/logs"
usage_json="$(python3 "$DIR/fetch_usage.py" 2>/dev/null || echo '{"ok":false}')"
log "usage $usage_json"

want="$(python3 - "$usage_json" "$THRESHOLD_PCT" "$RESET_PCT" "$(read_state mode)" "$(read_state billing_cycle_start)" <<'PY'
import json, sys
raw, thr, reset, mode, last_cycle = sys.argv[1], float(sys.argv[2]), float(sys.argv[3]), sys.argv[4], sys.argv[5]
try:
    u = json.loads(raw)
except Exception:
    u = {"ok": False}
if not u.get("ok"):
    print("unknown")
    raise SystemExit(0)
auto = float(u.get("auto_percent") or 0)
total = float(u.get("total_percent") or auto)
exhausted = bool(u.get("included_exhausted") or u.get("hit_limit"))
cycle = str(u.get("billing_cycle_start") or "")
if last_cycle and cycle and cycle != last_cycle:
    print("stock")
    raise SystemExit(0)
if exhausted or auto >= thr or total >= thr:
    print("codex")
    raise SystemExit(0)
if mode == "codex" and auto <= reset and not exhausted:
    print("stock")
    raise SystemExit(0)
print(mode or "stock")
PY
)"

log "decision want=$want current_mode=$(read_state mode) provider=$(current_provider || echo none)"

if [[ "$want" == "unknown" ]]; then
  log "no usage signal; leave provider unchanged"
  exit 0
fi

last_switch="$(read_state switched_at)"
now="$(date +%s)"
if [[ -n "$last_switch" && "$want" != "$(read_state mode)" ]]; then
  if (( now - last_switch < COOLDOWN_SEC )); then
    log "cooldown active; skip switch to $want"
    echo "$want" >"$DESIRED_FILE"
    exit 0
  fi
fi

cycle="$(python3 -c "import json,sys; print(json.loads(sys.argv[1]).get('billing_cycle_start',''))" "$usage_json" 2>/dev/null || true)"
echo "$want" >"$DESIRED_FILE"

if [[ "$want" == "$(read_state mode)" ]]; then
  write_state mode="$want" billing_cycle_start="$cycle"
  exit 0
fi

if in_sandbox && adapters_bin >/dev/null; then
  if [[ "$want" == "codex" ]]; then
    "$DIR/bin/use-codex"
  else
    "$DIR/bin/use-stock"
  fi
  write_state switched_at="$now" billing_cycle_start="$cycle"
else
  write_state mode="$(read_state mode)" pending="$want" billing_cycle_start="$cycle"
  if [[ "$want" == "codex" ]]; then
    notify "Official Cursor/Grok quota is at the threshold. In Grok Bot say \"switch to Codex\" or run bin/use-codex in the sandbox."
  else
    notify "Usage cycle reset. In Grok Bot say \"switch back to official\" or run bin/use-stock in the sandbox."
  fi
fi
